# ---------------------------------------------------------------------------
# Copy to config/.env and fill in locally.  config/.env is git-ignored and must
# never be committed, pasted into logs, or copied from another project.
# Credentials are one real username/password pair. Selectors are CSS locators
# for DOM elements; they are not credentials. Values below for selectors come
# from saved portal pages (static DOM evidence only, not live-validated).
# ---------------------------------------------------------------------------

# --- Huawei portal -------------------------------------------------------
HUAWEI_BASE_URL=https://172.16.24.3
HUAWEI_LOGIN_PATH=/view/login.html

# ONE credential pair used once per daily session (both exports share it).
HUAWEI_USERNAME=CHANGE_ME
HUAWEI_PASSWORD=CHANGE_ME

HUAWEI_HEADLESS=true
HUAWEI_LOGIN_TIMEOUT_SECONDS=45
HUAWEI_EXPORT_TIMEOUT_SECONDS=180
HUAWEI_NAV_TIMEOUT_SECONDS=60
# Expected download basenames produced by the portal export buttons.
AP_EXPORT_FILENAME=apInfo.csv
SSID_EXPORT_FILENAME=ssidInfo.csv

# Portal selectors (CSS/Playwright locators, NOT credentials).
# Login form (observed on the saved login page).
HUAWEI_SEL_LOGIN_USERNAME=#username
HUAWEI_SEL_LOGIN_PASSWORD=#password
HUAWEI_SEL_LOGIN_SUBMIT=#submitButton
# AP dashboard sidebar entry and its export control (observed on the saved AP page).
HUAWEI_SEL_NAV_AP=#dashAP
HUAWEI_SEL_EXPORT_AP=#outputApListInfoBtnEn
# SSID dashboard sidebar entry and its export control (observed on the saved SSID page).
HUAWEI_SEL_NAV_SSID=#dashSSIDs
HUAWEI_SEL_EXPORT_SSID=#ssidListExportBtn

# --- Retry policy (bounded) ----------------------------------------------
RETRY_ATTEMPTS=5
RETRY_BACKOFF_SECONDS=30
RETRY_MAX_BACKOFF_SECONDS=300

# --- Reports -------------------------------------------------------------
TEMPLATE_DIR=config/templates
OUTPUT_ROOT=output
# Optional explicit month (YYYY-MM). Empty means "current month in TIMEZONE".
REPORT_MONTH=
# Keep day tabs that have no raw snapshot (emptied) instead of removing them.
KEEP_EMPTY_DAY_TABS=true

# --- WhatsApp (GOWA-compatible) ------------------------------------------
GOWA_ENABLED=true
GOWA_BASE_URL=https://gateway.example.invalid
GOWA_DEVICE_ID=CHANGE_ME
GOWA_GROUP_JID=CHANGE_ME
GOWA_TIMEOUT_SECONDS=20

# --- TLS / logging -------------------------------------------------------
# Verification stays on. Point CA_BUNDLE at the office CA if the portal uses an
# internal certificate. There is no disable switch by design.
TLS_VERIFY=true
TLS_CA_BUNDLE=
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta